-- QUESTIONS

-- 1. what industry has the most employees? what industry has the least employees? (pull just the min and max, and then run another query that shows all industries ordered by employees desc)

WITH industry_totals AS (
    SELECT
        industry,
        SUM(employees) AS total_employees
    FROM fortune_companies
    GROUP BY industry
)

SELECT industry, total_employees
FROM industry_totals
WHERE total_employees = (SELECT MAX(total_employees) FROM industry_totals)
   OR total_employees = (SELECT MIN(total_employees) FROM industry_totals);


SELECT industry, SUM(employees) AS total_employees
FROM fortune_companies
GROUP BY industry
ORDER BY employees DESC;



-- 2. what is the average maternity leave provided by each industry? which companies offer above their industry's average maternity leave? (round to the nearest tenth)

WITH industry_avg_mat AS (
    SELECT
        industry,
        AVG(maternity_leave_weeks) AS avg_mat_weeks_industry
    FROM fortune_companies
    GROUP BY industry
)

SELECT
    f.industry,
    ROUND(i.avg_mat_weeks_industry, 1) AS avg_mat_weeks_industry,
    f.company_name,
    f.maternity_leave_weeks
FROM fortune_companies AS f
JOIN industry_avg_mat AS i
    ON f.industry = i.industry
WHERE f.maternity_leave_weeks > i.avg_mat_weeks_industry
ORDER BY f.industry;




--3. what percentage of all companies offer healthcare benefits? what about by industry?

SELECT
    ROUND(
        SUM(healthcare_benefits) * 100.0 / COUNT(*),
        1
    ) AS percent_with_healthcare
FROM fortune_companies;

SELECT industry,
    ROUND(
        SUM(healthcare_benefits) * 100.0 / COUNT(*),
        1
    ) AS percent_with_healthcare
FROM fortune_companies
GROUP BY industry
ORDER BY industry;


-- 4. what is each industry's average revenue compared to its average employee tenure?

SELECT industry, 
ROUND(AVG(revenue),1) AS avg_revenue_ind, 
ROUND(AVG(avg_employee_tenure),1) AS avg_tenure_ind
FROM fortune_companies
GROUP BY industry
ORDER BY industry;





-- 5. by industry, find the average of each of these: healthcare benefits, paid time off days, and maternity leave weeks. add the three industry averages together as a new column called avg_score_ind. then add each individual company's benefit values together as a company score. subtract the industry average score from the company score and call it distance_from_average. create a new column called "Score": if the distance is positive, return "Above Average". if it is 0, return "Average", otherwise return "Below Average".

WITH ind_avg_table AS (
    SELECT
        industry,
        AVG(healthcare_benefits) AS avg_hc_benefits_ind,
        AVG(paid_time_off_days) AS avg_pto_ind,
        AVG(maternity_leave_weeks) AS avg_mat_ind
    FROM fortune_companies
    GROUP BY industry
),

company_scores AS (
    SELECT
        f.company_name,
        f.industry,

        -- Sum of this company's three benefit values
        f.healthcare_benefits
            + f.paid_time_off_days
            + f.maternity_leave_weeks AS company_score,

        -- Sum of the three industry averages
        i.avg_hc_benefits_ind
            + i.avg_pto_ind
            + i.avg_mat_ind AS avg_score_ind

    FROM fortune_companies AS f
    JOIN ind_avg_table AS i
        ON f.industry = i.industry
)

SELECT
    company_name,
    industry,
    ROUND(company_score, 1) AS company_score,
    ROUND(avg_score_ind, 1) AS avg_score_ind,
    ROUND(company_score - avg_score_ind, 1) AS distance_from_average,

    CASE
        WHEN company_score - avg_score_ind > 0 THEN 'Above Average'
        WHEN company_score - avg_score_ind = 0 THEN 'Average'
        ELSE 'Below Average'
    END AS score

FROM company_scores
ORDER BY industry, company_name;
  
 
  
